<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8" />
    <title>Studentenliste</title>
</head>
<body>
    <h1>Studentenliste</h1>
    <p th:if="${message}" th:text="${message}"></p>
    <ul>
        <li th:each="student : ${students}" th:text="${student.name}">Beispielname</li>
    </ul>
</body>
</html>